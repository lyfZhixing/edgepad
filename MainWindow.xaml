<Window x:Class="EdgePad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgePad"
        Title="EdgePad · 触控板边缘手势"
        Icon="app.ico"
        Height="780" Width="1200"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="20,16,20,12" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock Text="EdgePad" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
        <TextBlock Text="触控板边缘手势" FontSize="13" Foreground="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
        <CheckBox x:Name="ChkEnabled" Content="启用" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkFreeze" Content="手势期间冻结光标" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkSnap" Content="松手吸附边缘" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkPalm" Content="防误触" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkNoClick" Content="屏蔽边缘点击" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Button x:Name="BtnFloat" Content="悬浮窗" Padding="12,6" Margin="0,0,12,0"/>
        <Button x:Name="BtnReset" Content="恢复默认" Padding="12,6"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="20,0,20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="450"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Padding="12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="4,10,4,0" LastChildFill="False">
            <TextBlock x:Name="TxtDev" DockPanel.Dock="Left" Foreground="{StaticResource Dim}" FontSize="12"/>
            <TextBlock x:Name="TxtRate" DockPanel.Dock="Left" Foreground="{StaticResource Dim}" FontSize="12" Margin="18,0,0,0"/>
            <Button x:Name="BtnClear" DockPanel.Dock="Right" Content="清除轨迹" Padding="10,3" FontSize="11"/>
          </DockPanel>
          <local:PadView x:Name="Pad"/>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="18,0,0,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <Button x:Name="TabEdge" Content="边缘手势" Style="{StaticResource TabButton}" Margin="0,0,6,0"/>
          <Button x:Name="TabTap" Content="边缘点击" Style="{StaticResource TabButton}" Margin="0,0,6,0"/>
          <Button x:Name="TabPad" Content="全板手势" Style="{StaticResource TabButton}"/>
        </StackPanel>
        <TextBlock x:Name="TxtHint" DockPanel.Dock="Bottom" Text="拖动触控板上的紫色边界线调整边缘范围；动作起手必须落在对应边缘内。"
                   Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="BindingsPanel"/>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="20,7">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="ChkTray" Content="最小化到托盘" Foreground="{StaticResource Dim}"
                    FontSize="11.5" VerticalAlignment="Center" Margin="0,0,18,0" Cursor="Hand"/>
          <CheckBox x:Name="ChkStartup" Content="开机启动" Foreground="{StaticResource Dim}"
                    FontSize="11.5" VerticalAlignment="Center" Cursor="Hand"/>
        </StackPanel>
        <TextBlock x:Name="TxtStatus" Foreground="{StaticResource Dim}" FontSize="12" Text="就绪"
                   VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
